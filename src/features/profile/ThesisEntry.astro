---
import { Image } from 'astro:assets';
import { assetHref, type Locale } from '../../i18n';
import type { Profile } from './content';
interface Props { locale: Locale; profile: Profile }
const { locale, profile } = Astro.props;
const thesis = profile.data.thesis;
---
{thesis && <article class="publication" id="thesis">
  <Image src={thesis.cover} alt={thesis.coverAlt[locale]} width={600} class="publication-cover"/>
  <div>
    <p class="entry-meta">{thesis.year} · <span>{locale === 'en' ? 'Undergraduate thesis' : '本科毕业论文 / Undergraduate thesis'}</span> · {thesis.institution[locale]}</p>
    <h2>{thesis.title[locale]}</h2>
    <p class="authors">{profile.data.name[locale]}</p>
    <p>{thesis.summary[locale]}</p>
    <div class="entry-links"><a href={assetHref(thesis.pdfPath)}>{locale === 'en' ? 'Chinese PDF' : '中文 PDF'}</a></div>
  </div>
</article>}
