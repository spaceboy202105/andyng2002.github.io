---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { locales, pageHref } from '../../../i18n';
export function getStaticPaths() { return locales.map(locale => ({ params: { lang: locale }, props: { locale } })); }
const { locale } = Astro.props;
const entries = (await getCollection('films')).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt) || a.id.localeCompare(b.id));
const title = locale === 'en' ? 'Films' : '电影评论';
---
<SiteLayout locale={locale} title={title} target={{kind:'films'}}>
  <section class="listing"><h1>{title}</h1>
    {entries.length ? <div class="blog-list">{entries.map(({ id, data }) => <article>
      <p class="entry-meta"><time datetime={data.publishedAt}>{data.publishedAt}</time> · {data.lang === 'en' ? 'English' : '中文'}</p>
      <h2 lang={data.lang}><a href={pageHref({locale,target:{kind:'filmReview',id}})}>{data.title}</a></h2>
    </article>)}</div> : <p class="empty-state">{locale === 'en' ? 'No film reviews yet.' : '暂未发布电影评论。'}</p>}
  </section>
</SiteLayout>
