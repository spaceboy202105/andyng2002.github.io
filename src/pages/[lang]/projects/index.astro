---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ProjectGrid from '../../../features/projects/ProjectGrid.astro';
import { getProjects } from '../../../features/projects/content';
import { locales } from '../../../i18n';
export function getStaticPaths() { return locales.map(locale => ({ params: { lang: locale }, props: { locale } })); }
const { locale } = Astro.props;
const entries = await getProjects();
const title = locale === 'en' ? 'Projects' : '个人项目';
---
<SiteLayout locale={locale} title={title} target={{kind:'projects'}}>
  <section class="listing"><h1>{title}</h1>
    {entries.length ? <ProjectGrid locale={locale} entries={entries}/> : <p class="empty-state">{locale === 'en' ? 'No projects listed yet.' : '暂未列出个人项目。'}</p>}
  </section>
</SiteLayout>
