{
  "name": "andy-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321 --ignore-lock",
    "test:e2e": "playwright test",
    "test:content": "node --test --test-concurrency=1 tests/build/*.test.mjs",
    "test:artifacts": "node --test --test-concurrency=1 tests/artifacts/*.test.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "verify": "npm run check && npm run test:content && npm run test:artifacts && npm run test:e2e && npm run test:cv && npm run test:cv-missing && npm run test:subpath && npm run build && npm run check:artifacts",
    "build:cv": "node scripts/build-cv.mjs",
    "test:cv": "playwright test --config playwright.cv.config.ts",
    "test:cv-missing": "playwright test --config playwright.cv-missing.config.ts",
    "test:subpath": "playwright test --config playwright.release.config.ts",
    "verify:release": "npm run verify && node scripts/check-artifacts.mjs --release"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.7",
    "katex": "0.19.0",
    "parse5": "7.3.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
